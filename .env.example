# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# YouTube Data API v3 Key (get from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database URL (default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./analytics.db

# Monitoring intervals (in minutes)
VIDEO_CHECK_INTERVAL=10
STATS_COLLECT_INTERVAL=30

# Notification thresholds
VIRAL_VIEW_THRESHOLD=100000
VIRAL_NOTIFICATION_STEP=100000

# Growth detection
GROWTH_RATE_THRESHOLD=50.0
GROWTH_TIME_WINDOW=60
